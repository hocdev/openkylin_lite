diff --git a/debian/orca.postinst b/debian/orca.postinst
index 9349259..1936567 100755
--- a/debian/orca.postinst
+++ b/debian/orca.postinst
@@ -1,32 +1,7 @@
 #!/bin/sh
 set -e
-
-speechd_conf=/etc/speech-dispatcher/speechd.conf
-speechd_dir="$(dirname "$speechd_conf")"
-
-default_module=xunfei_speech
-if [ -f /etc/os-release ] && grep -q '^NAME="openKylin"$' /etc/os-release; then
-    default_module=kylin_speech
+if [ "$1" = configure ] && [ -f /etc/speech-dispatcher/speechd.conf ]; then
+    sed -i -E '/^AddModule "(kylin_speech|xunfei_speech|xfspark|xfspark-native)" /d; s/^DefaultModule "?(kylin_speech|xunfei_speech|xfspark|xfspark-native)"?$/DefaultModule espeak-ng/' /etc/speech-dispatcher/speechd.conf
 fi
-
-if [ "$1" = "configure" ]; then
-    mkdir -p "$speechd_dir"
-    touch "$speechd_conf"
-
-    sed -i '/^AddModule "xfspark" ".*" "xfspark.conf"$/d' "$speechd_conf"
-    sed -i '/^AddModule "xfspark-native" "sd_xfspark" "xfspark-native.conf"$/d' "$speechd_conf"
-    sed -i '/^AddModule "kylin_speech" "sd_kylin_speech" "kylin_speech.conf"$/d' "$speechd_conf"
-    sed -i '/^AddModule "xunfei_speech" "sd_xunfei_speech" "xunfei_speech.conf"$/d' "$speechd_conf"
-    printf '%s\n' 'AddModule "kylin_speech" "sd_kylin_speech" "kylin_speech.conf"' >> "$speechd_conf"
-    printf '%s\n' 'AddModule "xunfei_speech" "sd_xunfei_speech" "xunfei_speech.conf"' >> "$speechd_conf"
-
-    if grep -q '^DefaultModule ' "$speechd_conf"; then
-        sed -i "s/^DefaultModule .*/DefaultModule ${default_module}/" "$speechd_conf"
-    else
-        printf '%s\n' "DefaultModule ${default_module}" >> "$speechd_conf"
-    fi
-fi
-
 #DEBHELPER#
-
 exit 0
