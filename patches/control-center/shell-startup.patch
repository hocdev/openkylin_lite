+void ukccSessionServer::watchSecurityFiles()
+{
+    for (const QString &path : {GetSecurityConfigPath(),
+         mUsdJsonFile,
+         QDir::homePath() + "/.config/ukui-control-center-security-config.json",
+         QStringLiteral("/usr/share/ukui-control-center/data/ukui-control-center-security-config.json")}) {
+        if (path.isEmpty()) continue;
+        if (QFile::exists(path) && !m_securityWatcher->files().contains(path))
+            m_securityWatcher->addPath(path);
+        // Watching a directory also catches new files and atomic replacement.
+        QString directory = QFileInfo(path).absolutePath();
+        while (!QDir(directory).exists()) {
+            const QString parent = QFileInfo(directory).absolutePath();
+            if (parent == directory) break;
+            directory = parent;
+        }
+        if (QDir(directory).exists() && !m_securityWatcher->directories().contains(directory))
+            m_securityWatcher->addPath(directory);
+    }
 }
 
