+void MainWindow::requestModulePolicy(std::function<void()> callback)
+{
+    m_policyCallbacks.push_back(std::move(callback));
+    if (m_policyPending) return;
+    m_policyPending = true;
+    queryAbout<QVariantMap>(this, QDBusConnection::sessionBus(), "org.ukui.ukcc.session", "/",
+        "org.ukui.ukcc.session.interface", "getModuleHideStatus", {},
+        [this](bool ok, const QVariantMap &policy) {
+            // Match the former first-call failure fallback, but preserve a
+            // known policy through subsequent backend failures.
+            if (ok || !qApp->property("_ukccPolicyReady").toBool())
+                qApp->setProperty("_ukccModulePolicy", ok ? policy : QVariantMap());
+            qApp->setProperty("_ukccPolicyReady", true);
+            m_ModuleMap = qApp->property("_ukccModulePolicy").toMap();
+            m_policyPending = false;
+            const bool refreshAgain = m_policyRefreshAgain;
+            m_policyRefreshAgain = false;
+            auto callbacks = std::move(m_policyCallbacks);
+            m_policyCallbacks.clear();
+            for (const auto &callback : callbacks) callback();
+            if (refreshAgain) refreshModulePolicy();
+        });
+}
+
+void MainWindow::refreshModulePolicy()
+{
+    // A config/owner change during an in-flight lookup needs a fresh request.
+    if (m_policyPending) {
+        m_policyRefreshAgain = true;
+        return;
+    }
+    requestModulePolicy([] {});
+}
